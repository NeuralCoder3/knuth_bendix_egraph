+(?a ?b) = +(?b ?a)
*(?a ?b) = *(?b ?a)
+ ?a((+, ?b, ?c)) = +((+, ?a, ?b) ?c)
* ?a((*, ?b, ?c)) = *((*, ?a, ?b) ?c)
-(?a ?b) = + ?a((*, -1, ?b))
/(?a ?b) = * ?a((pow, ?b, -1))
+(?a 0) = ?a
*(?a 0) = 0
*(?a 1) = ?a
?a = +(?a 0)
?a = *(?a 1)
-(?a ?a) = 0
/(?a ?a) = 1
* ?a((+, ?b, ?c)) = +((*, ?a, ?b) (*, ?a, ?c))
+((*, ?a, ?b) (*, ?a, ?c)) = * ?a((+, ?b, ?c))
*((pow, ?a, ?b) (pow, ?a, ?c)) = pow ?a((+, ?b, ?c))
pow(?x 0) = 1
pow(?x 1) = ?x
pow(?x 2) = *(?x ?x)
pow(?x -1) = /(1 ?x)
* ?x((/, 1, ?x)) = 1
d(?x ?x) = 1
d ?x((+, ?a, ?b)) = +((d, ?x, ?a) (d, ?x, ?b))
d ?x((*, ?a, ?b)) = +((*, ?a, (d ?x ?b)) (*, ?b, d(?x ?a)))
d ?x((sin, ?x)) = cos(?x)
d ?x((cos, ?x)) = * -1((sin, ?x))
d ?x((ln, ?x)) = /(1 ?x)
i(1 ?x) = ?x
i((cos, ?x) ?x) = sin(?x)
i((sin, ?x) ?x) = * -1((cos, ?x))
i((+, ?f, ?g) ?x) = +((i, ?f, ?x) (i, ?g, ?x))
i((-, ?f, ?g) ?x) = -((i, ?f, ?x) (i, ?g, ?x))
